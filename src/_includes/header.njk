  <!-- Announcement Bar -->
  <div class="announcement-bar">
    <div class="container">
      <a href="https://bsidestampa.net" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="3" y1="11" x2="21" y2="11"/></svg>
        <strong>BSides Tampa 2026 is Saturday, May 16 at USF.</strong> Tickets are on sale at bsidestampa.net.
        <span class="announcement-arrow">→</span>
      </a>
    </div>
  </div>

  <!-- Header -->
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo">
        <img src="{{ site.logo }}" alt="{{ site.name }} Chapter">
      </a>
      <nav class="main-nav" id="mainNav">
        <button class="nav-toggle" aria-label="Toggle navigation" onclick="document.getElementById('mainNav').classList.toggle('open')">
          <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
        </button>
        <ul>
          {%- for item in navigation %}
          {% if item.children %}
          <li class="has-dropdown">
            <button class="dropdown-toggle" type="button" aria-expanded="false" aria-haspopup="true">
              {{ item.label }}
              <svg class="dropdown-caret" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
            </button>
            <ul class="dropdown">
              {%- for child in item.children %}
              <li><a href="{{ child.url }}"{% if page.url === child.url %} class="active"{% endif %}>{{ child.label }}</a></li>
              {%- endfor %}
            </ul>
          </li>
          {% else %}
          <li>
            <a href="{{ item.url }}"{% if page.url === item.url %} class="active"{% endif %}>{{ item.label }}</a>
          </li>
          {% endif %}
          {%- endfor %}
        </ul>
        <a href="/membership/" class="nav-cta">Become a Member</a>
      </nav>
    </div>
  </header>

  <script>
    (function () {
      var mainNav = document.getElementById('mainNav');

      // Close mobile menu when a nav link is tapped
      document.querySelectorAll('.main-nav a').forEach(function (link) {
        link.addEventListener('click', function () {
          mainNav.classList.remove('open');
          closeAllDropdowns();
        });
      });

      // Dropdown submenus: click/tap only
      var parents = document.querySelectorAll('.main-nav .has-dropdown');

      function closeAllDropdowns(except) {
        parents.forEach(function (p) {
          if (p === except) return;
          p.classList.remove('is-open');
          var btn = p.querySelector('.dropdown-toggle');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        });
      }

      parents.forEach(function (parent) {
        var btn = parent.querySelector('.dropdown-toggle');
        if (!btn) return;
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var willOpen = !parent.classList.contains('is-open');
          closeAllDropdowns(willOpen ? parent : null);
          parent.classList.toggle('is-open', willOpen);
          btn.setAttribute('aria-expanded', String(willOpen));
        });
      });

      // Click outside closes any open dropdown
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.main-nav .has-dropdown')) closeAllDropdowns();
      });

      // Escape closes and returns focus to the toggle
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        parents.forEach(function (p) {
          if (!p.classList.contains('is-open')) return;
          p.classList.remove('is-open');
          var btn = p.querySelector('.dropdown-toggle');
          if (btn) {
            btn.setAttribute('aria-expanded', 'false');
            btn.focus();
          }
        });
      });
    })();
  </script>
