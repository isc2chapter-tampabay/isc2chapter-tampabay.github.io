  <!-- Page Header -->
  <div class="page-header">
    <div class="container">
      <h1>Mentorship</h1>
      <p class="page-header-subtitle">Pair up with someone who's been where you're going.</p>
    </div>
  </div>

  <!-- Overview -->
  <section class="content-section">
    <div class="container">
      <span class="section-label">Launching now</span>
      <h2>Good mentors change careers</h2>
      <p>We're launching a mentorship program to connect security professionals across the Tampa Bay chapter — at every stage of the field.</p>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="content-section" style="background: var(--light-gray);">
    <div class="container">
      <span class="section-label">Who it's for</span>
      <h2>Everyone, honestly</h2>
      <ul class="benefits-list">
        <li><strong>Students and career-changers</strong> looking for guidance on breaking in, what to study next, or how to handle a first security role.</li>
        <li><strong>Mid-career practitioners</strong> who want perspective from someone more senior in their specialty or an adjacent one.</li>
        <li><strong>Senior members</strong> who want to give back and sharpen their own coaching.</li>
      </ul>
    </div>
  </section>

  <!-- How pairing works -->
  <section class="content-section">
    <div class="container">
      <span class="section-label">How it works</span>
      <h2>Three steps to get paired</h2>
      <ol>
        <li><strong>Sign up.</strong> Tell us a bit about yourself and whether you'd like to mentor, be mentored, or both.</li>
        <li><strong>We match you.</strong> A chapter officer pairs you based on specialty, interests, and availability.</li>
        <li><strong>You meet.</strong> Virtual or in person, at whatever cadence works for the two of you.</li>
      </ol>
    </div>
  </section>

  <!-- What we ask -->
  <section class="content-section" style="background: var(--light-gray);">
    <div class="container">
      <span class="section-label">What we ask</span>
      <h2>A few ground rules</h2>
      <ul class="benefits-list">
        <li><strong>Respect each other's time.</strong> Don't ghost.</li>
        <li><strong>Keep it professional.</strong> Follow the <a href="https://www.isc2.org/ethics">ISC2 Code of Ethics</a>.</li>
        <li><strong>Show up.</strong> Even 30 minutes a month can change someone's trajectory.</li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
